{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldBullionMarketRateSchema",
  "description": "Pure schema contract for dynamic live bullion rate feeds",
  "type": "object",
  "properties": {
    "lastUpdated": { "type": "string", "format": "date-time" },
    "displayUpdated": { "type": "string" },
    "source": { "type": "string" },
    "isLive": { "type": "boolean" },
    "currency": { "type": "string", "default": "INR" },
    "national": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "karat": { "type": "string" },
          "purity": { "type": "string" },
          "perGram": { "type": "number" },
          "per10g": { "type": "number" },
          "change": { "type": "number" },
          "direction": { "type": "string", "enum": ["up", "down", "stable"] }
        },
        "required": ["karat", "purity", "perGram", "per10g"]
      }
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "gold24k": { "type": "number" },
          "gold22k": { "type": "number" },
          "silver1kg": { "type": "number" }
        },
        "required": ["city", "gold24k", "gold22k"]
      }
    }
  }
}