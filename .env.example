# ===================================================
# UNIQUEDIGIT SERVER ENVIRONMENT CONFIGURATION
# ===================================================

# Server-only Gemini API Key (DO NOT prefix with VITE_)
# Get your free key at: https://aistudio.google.com/apikey
# In Antigravity: Set this in Antigravity Secrets / Server Env
GEMINI_API_KEY=

# Server Port (for standalone Node server)
PORT=3001

# Telegram Live Notifications & Alerts
TELEGRAM_BOT_TOKEN=        # From @BotFather (e.g. 123456:ABC-DEF...)
TELEGRAM_CHAT_ID=          # Your numeric chat ID from @userinfobot (e.g. 987654321)
PORTAL_BASE_URL=https://dk-s.pages.dev
